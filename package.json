{
  "name": "studium-os",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Studium OS – lokales Arbeitsinstrument für das Studium",
  "scripts": {
    "dev": "vite",
    "dev:browser": "vite --mode mock",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:rust": "cargo test -p studium-core",
    "tauri": "tauri"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
