{
  "name": "studium-os",
  "private": true,
  "version": "0.6.0",
  "type": "module",
  "description": "Studium OS – lokales Arbeitsinstrument für das Studium",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:rust": "cargo test -p studium-core",
    "tauri": "tauri",
    "build:web": "tsc --noEmit && vite build --mode web",
    "test:web": "node tests/e2e-web/web-e2e.mjs",
    "test:editor": "node tests/e2e-web/editor-e2e.mjs",
    "test:struktur": "node tests/e2e-web/struktur-e2e.mjs",
    "eval": "RUN_EVAL=1 vitest run --config eval/vitest.config.ts",
    "eval:vergleich": "node eval/vergleich.mjs",
    "test:gesetze": "RUN_GII_REAL=1 vitest run --config eval/vitest.config.ts eval/gii-echt.eval.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.129.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@noble/hashes": "2.0.1",
    "@sqlite.org/sqlite-wasm": "3.53.4-build1",
    "@tauri-apps/api": "^2.12.3",
    "@tauri-apps/plugin-dialog": "^2.8.2",
    "@tiptap/extension-highlight": "^3.32.0",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-mathematics": "^3.32.0",
    "@tiptap/extension-placeholder": "^3.32.0",
    "@tiptap/extension-subscript": "^3.32.0",
    "@tiptap/extension-superscript": "^3.32.0",
    "@tiptap/extension-table": "^3.32.0",
    "@tiptap/extension-task-item": "^3.32.0",
    "@tiptap/extension-task-list": "^3.32.0",
    "@tiptap/extension-text-align": "^3.32.0",
    "@tiptap/extension-text-style": "^3.32.0",
    "@tiptap/extension-typography": "^3.32.0",
    "@tiptap/extensions": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "docx": "^9.11.0",
    "katex": "^0.18.10",
    "lucide-react": "^1.57.0",
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "ts-fsrs": "^5.4.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^29.1.1",
    "jszip": "^3.10.2",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "yaml": "2.9.1"
  }
}
